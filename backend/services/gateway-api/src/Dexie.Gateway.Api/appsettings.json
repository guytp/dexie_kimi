{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MongoDB": "${MONGODB_CONNECTION_STRING}"
  },
  "RabbitMQ": {
    "Host": "${RABBITMQ_HOST}",
    "Port": "${RABBITMQ_PORT}",
    "Username": "${RABBITMQ_USERNAME}",
    "Password": "${RABBITMQ_PASSWORD}"
  },
  "ApiGateway": {
    "CardsServiceUrl": "${CARDS_SERVICE_URL}",
    "ListingsServiceUrl": "${LISTINGS_SERVICE_URL}",
    "PricesServiceUrl": "${PRICES_SERVICE_URL}"
  }
}
